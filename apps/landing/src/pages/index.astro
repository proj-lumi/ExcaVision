---
import 'leaflet/dist/leaflet.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Installed tilt sensors and a monitoring app for Philippine excavation, retaining-wall, and equipment-base sites." />
    <title>ExcaVision | Tilt sensors and monitoring app for Philippine sites</title>
    <link rel="preload" as="image" href="/media/metro-manila-excavation.webp" type="image/webp" />
    <script is:inline src="/config.js"></script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
  </head>
  <body id="top">
    <span id="page-start" class="scroll-sentinel" aria-hidden="true"></span>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="#top" aria-label="ExcaVision home">ExcaVision</a>
        <button id="menu-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav id="site-nav" class="nav" aria-label="Main navigation">
          <a href="#scope" data-section="scope">What it covers</a>
          <a href="#approach" data-section="approach">How it works</a>
          <a href="#system" data-section="system">The system</a>
          <a class="nav-cta" href="#request" data-section="request">Request installation</a>
        </nav>
      </div>
    </header>

    <a id="backToTop" class="back-to-top" href="#top" aria-label="Back to top" title="Back to top">↑</a>

    <main>
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy-block">
            <h1>Tilt monitoring, installed.</h1>
            <p class="hero-copy">Site sensors, app access, movement history, and threshold alerts for Philippine excavation and retaining-wall projects.</p>
            <div class="actions">
              <a class="btn btn-primary" href="#request">Request installation</a>
            </div>
          </div>
          <figure class="hero-visual">
            <img src="/media/metro-manila-excavation.webp" width="1600" height="900" alt="Active excavation work at the Metro Manila Subway Shaw Station site" fetchpriority="high" decoding="async" />
          </figure>
        </div>
      </section>

      <section id="scope" class="service-scope" aria-labelledby="scope-title">
        <div class="wrap scope-grid">
          <header>
            <h2 id="scope-title">One service from setup to monitoring.</h2>
          </header>
          <div class="scope-list">
            <article><h3>Installed hardware</h3><p>Sensors placed for the site and connected as one monitored system.</p></article>
            <article><h3>Monitoring app</h3><p>Current readings, movement history, and site status on your phone.</p></article>
            <article><h3>Threshold alerts</h3><p>Notifications when a configured movement limit is crossed.</p></article>
          </div>
        </div>
      </section>

      <section id="approach" class="section process-section">
        <div class="wrap">
          <header class="section-heading">
            <h2>From installation request to live monitoring.</h2>
          </header>
          <ol class="process-list">
            <li><h3>Describe the site</h3><p>Share the location and what needs monitoring.</p></li>
            <li><h3>Plan the coverage</h3><p>We review the request and recommend sensor placement.</p></li>
            <li><h3>Install and baseline</h3><p>We install the hardware, capture a baseline, and open app access.</p></li>
          </ol>
        </div>
      </section>

      <section id="system" class="section system-section">
        <div class="wrap system-grid">
          <figure class="system-visual">
            <img src="/media/bulacan-retaining-wall.webp" width="1400" height="1050" alt="Retaining-wall and slope-protection work beside a river in Bulacan" loading="lazy" decoding="async" />
          </figure>
          <div class="system-copy">
            <h2>Movement history from fixed points.</h2>
            <p>Each installed node records tilt at a known position. The app keeps current readings, history, and configured alerts together.</p>
            <div class="boundary-note"><strong>Monitoring supports decisions.</strong><p>It does not replace an engineer's assessment, inspection, or emergency response.</p></div>
          </div>
        </div>
      </section>

      <section id="request" class="request-area">
        <div class="wrap request-grid">
          <header id="requestIntro" class="request-heading">
            <h2>Request an installation.</h2>
            <p>Share the site and concern. We will recommend the coverage.</p>
          </header>
          <div class="request-panel">
            <div id="wizard">
              <div class="progress" aria-live="polite"><strong id="stepLabel">1 of 2</strong><span class="progress-bar"><i id="barFill"></i></span><span id="stepName">Contact</span></div>
              <div id="question" class="question"></div>
              <div id="error" class="error hidden" role="alert" tabindex="-1"></div>
            </div>
            <div id="success" class="success" role="status">
              <div class="success-mark" aria-hidden="true">✓</div>
              <h2>Request received.</h2>
              <p>We will contact you to confirm the site and next step.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div><strong>ExcaVision</strong><span>Installed tilt monitoring</span></div>
        <p>Photography: <a href="https://commons.wikimedia.org/wiki/File:Metro_Manila_Subway_Project_Shaw_Station_12Jan2025_20.jpg">RFNirmala</a> and <a href="https://commons.wikimedia.org/wiki/File:0201jfTigpalas_Bridge_San_Miguel_River_Bulacan_Slope_Protection_Stability_Retaining_wallsfvf_10.jpg">Judgefloro</a>, Wikimedia Commons, CC0.</p>
      </div>
    </footer>
  </body>
</html>

<script>
  import L from 'leaflet';

  const state = {
    step: 1,
    requestType: 'Request installation',
    name: '',
    company: '',
    email: '',
    phone: '',
    locationName: '',
    where: '',
    locationNotes: '',
    website: '',
    formStartedAt: Date.now(),
    turnstileToken: '',
    locationConfirmed: false,
    selectedLocationLabel: '',
    mapLat: null,
    mapLng: null,
  };

  const steps = ['Contact', 'Location'];
  const philippinesBounds = L.latLngBounds([4.2, 116.5], [21.5, 127.0]);
  const root = document.querySelector('#question');
  const error = document.querySelector('#error');
  let leafletMap;
  let mapMarker;
  let searchResults = [];

  function safe(value) {
    return String(value || '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[character]));
  }

  function formatPhilippinePhone(value) {
    let digits = String(value || '').replace(/\D/g, '');
    if (digits.startsWith('63')) digits = `0${digits.slice(2)}`;
    digits = digits.slice(0, 11);
    return [digits.slice(0, 4), digits.slice(4, 7), digits.slice(7, 11)].filter(Boolean).join(' ');
  }

  function updateProgress() {
    document.querySelector('#stepLabel').textContent = `${state.step} of 2`;
    document.querySelector('#stepName').textContent = steps[state.step - 1];
    document.querySelector('#barFill').style.transform = `scaleX(${state.step / 2})`;
    error.classList.add('hidden');
  }

  function animateQuestion() {
    root.classList.remove('question-enter');
    void root.offsetWidth;
    root.classList.add('question-enter');
  }

  function resetMap() {
    if (leafletMap) {
      leafletMap.remove();
      leafletMap = undefined;
      mapMarker = undefined;
    }
  }

  function initMap() {
    const mapElement = document.querySelector('#location-map');
    if (!mapElement) return;

    leafletMap = L.map(mapElement, {
      zoomControl: false,
      maxBounds: philippinesBounds,
      maxBoundsViscosity: 1,
      minZoom: 5,
    }).setView([12.8797, 121.774], 5);
    L.control.zoom({ position: 'bottomright' }).addTo(leafletMap);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a> contributors',
    }).addTo(leafletMap);

    if (state.locationConfirmed && state.mapLat !== null && state.mapLng !== null) {
      setMarker([state.mapLat, state.mapLng], false);
      leafletMap.setView([state.mapLat, state.mapLng], 13);
    }

    leafletMap.on('click', (event) => {
      if (!philippinesBounds.contains(event.latlng)) {
        document.querySelector('#map-help').textContent = 'Choose a location within the Philippines.';
        return;
      }
      state.mapLat = event.latlng.lat;
      state.mapLng = event.latlng.lng;
      state.locationConfirmed = true;
      state.selectedLocationLabel = 'Approximate map pin';
      const searchInput = document.querySelector('#location-search');
      if (searchInput) searchInput.value = '';
      document.querySelector('.map-search-row')?.classList.add('hidden');
      document.querySelector('#selected-place')?.classList.remove('hidden');
      document.querySelector('#selected-place span').textContent = state.selectedLocationLabel;
      document.querySelector('#search-results').innerHTML = '';
      document.querySelector('#search-status').textContent = 'Philippines locations only';
      setMarker([state.mapLat, state.mapLng], true);
    });
  }

  function setMarker(latLng, updateMessage) {
    const markerIcon = L.divIcon({
      className: 'location-marker',
      html: '<span></span>',
      iconSize: [20, 20],
      iconAnchor: [10, 10],
    });

    if (mapMarker) mapMarker.setLatLng(latLng);
    else mapMarker = L.marker(latLng, { icon: markerIcon }).addTo(leafletMap);

    if (updateMessage) {
      document.querySelector('#map-help').textContent = 'Approximate point selected. You can adjust it.';
    }
  }

  function render() {
    resetMap();
    updateProgress();

    if (state.step === 1) {
      root.innerHTML = `
        <h3>Contact details</h3>
        <div class="form-grid">
          <div class="field"><label for="name">Your name <span class="required" aria-hidden="true">*</span></label><input id="name" value="${safe(state.name)}" autocomplete="name" placeholder="Full name" /></div>
          <div class="field"><label for="company">Company or team <span class="hint">Optional</span></label><input id="company" value="${safe(state.company)}" placeholder="Company name" /></div>
          <div class="field"><label for="email">Email <span class="required" aria-hidden="true">*</span></label><input id="email" value="${safe(state.email)}" type="email" autocomplete="email" placeholder="you@example.com" /></div>
          <div class="field"><label for="phone">Phone <span class="required" aria-hidden="true">*</span></label><input id="phone" value="${safe(state.phone)}" autocomplete="tel" inputmode="tel" maxlength="13" placeholder="09xx xxx xxxx" /></div>
        </div>
        <div class="question-actions"><button class="text-btn" type="button" data-back>Back</button><button class="btn btn-primary" type="button" data-next>Continue</button></div>`;
      animateQuestion();

      root.querySelector('#phone').addEventListener('input', (event) => {
        event.target.value = formatPhilippinePhone(event.target.value);
      });
      root.querySelector('[data-back]').addEventListener('click', back);
      root.querySelector('[data-next]').addEventListener('click', next);
      return;
    }

    root.innerHTML = `
      <h3>Where is the site?</h3>
      <div class="location-layout">
        <div>
          <div class="field"><label for="locationName">Site or project name <span class="required" aria-hidden="true">*</span></label><input id="locationName" value="${safe(state.locationName)}" placeholder="For example, North Ridge Quarry" /></div>
          <div class="field"><label for="locationNotes">Additional location information <span class="hint">Optional</span></label><textarea id="locationNotes" placeholder="Access road, nearby building, area name...">${safe(state.locationNotes)}</textarea></div>
          <label class="spam-field" aria-hidden="true">Website<input id="website" tabindex="-1" autocomplete="off" value="${safe(state.website)}" /></label>
          <div id="turnstile-container" class="turnstile-check" aria-label="Request verification"></div>
        </div>
        <div class="map-card">
          <div class="map-search">
            <label for="location-search">Mark the location on the map <span class="required" aria-hidden="true">*</span></label>
            <div class="map-search-row ${state.locationConfirmed ? 'hidden' : ''}"><input id="location-search" type="search" autocomplete="off" placeholder="Search a city, landmark, or address" /></div>
            <div id="selected-place" class="selected-place ${state.locationConfirmed ? '' : 'hidden'}"><span>${safe(state.selectedLocationLabel)}</span><button type="button" data-change-location>Change</button></div>
            <div id="search-status" class="search-status" aria-live="polite">Philippines locations only</div>
            <div id="search-results" class="search-results" role="listbox"></div>
          </div>
          <div id="location-map" class="map-box" aria-label="Approximate location picker"></div>
          <div id="map-help" class="map-help">${state.locationConfirmed ? 'Approximate point selected. You can adjust it.' : 'Select a suggestion or click the map to place an approximate pin.'}</div>
        </div>
      </div>
      <p class="request-note">By sending this request, you are asking ExcaVision Service to contact you. Any site survey will be arranged separately.</p>
      <div class="question-actions"><button class="text-btn" type="button" data-back>Back</button><button class="btn btn-primary" type="button" data-submit>Send request</button></div>`;
    animateQuestion();

    root.querySelector('#locationName').addEventListener('input', (event) => { state.locationName = event.target.value; });
    root.querySelector('#locationNotes').addEventListener('input', (event) => { state.locationNotes = event.target.value; });
    root.querySelector('[data-change-location]')?.addEventListener('click', () => {
      state.locationConfirmed = false;
      state.selectedLocationLabel = '';
      state.where = '';
      state.mapLat = null;
      state.mapLng = null;
      render();
    });
    root.querySelector('[data-back]').addEventListener('click', back);
    root.querySelector('[data-submit]').addEventListener('click', submitRequest);
    root.querySelector('#location-search').addEventListener('input', scheduleSearch);
    initMap();
    renderTurnstile();
  }

  function renderTurnstile(attempt = 0) {
    const container = root.querySelector('#turnstile-container');
    if (!container) return;
    const siteKey = (window as any).EXCAVISION_CONFIG?.turnstileSiteKey;
    if (!siteKey) {
      if (['localhost', '127.0.0.1'].includes(window.location.hostname)) container.classList.add('hidden');
      else container.textContent = 'Request verification is unavailable. Please reload or contact ExcaVision.';
      return;
    }

    const turnstile = (window as any).turnstile;
    if (!turnstile) {
      if (attempt < 50) window.setTimeout(() => renderTurnstile(attempt + 1), 100);
      else container.textContent = 'Request verification did not load. Please reload and try again.';
      return;
    }

    state.turnstileToken = '';
    turnstile.render(container, {
      sitekey: siteKey,
      action: 'installation_request',
      callback: (token) => { state.turnstileToken = token; },
      'expired-callback': () => { state.turnstileToken = ''; },
      'error-callback': () => { state.turnstileToken = ''; },
      theme: 'light',
    });
  }

  let searchTimer;
  let searchController;

  function scheduleSearch() {
    const input = root.querySelector('#location-search');
    const status = root.querySelector('#search-status');
    const results = root.querySelector('#search-results');
    const query = input.value.trim();

    window.clearTimeout(searchTimer);
    if (searchController) searchController.abort();
    results.innerHTML = '';

    if (query.length < 2) {
      status.textContent = query ? 'Type at least 2 characters to see suggestions.' : 'Philippines locations only';
      return;
    }

    status.textContent = 'Looking for matching places...';
    searchTimer = window.setTimeout(() => searchLocations(query), 350);
  }

  async function searchLocations(query) {
    const status = root.querySelector('#search-status');
    const results = root.querySelector('#search-results');
    searchController = new AbortController();

    try {
      const params = new URLSearchParams({
        q: query,
        format: 'jsonv2',
        addressdetails: '1',
        countrycodes: 'ph',
        limit: '5',
      });
      const response = await fetch(`https://nominatim.openstreetmap.org/search?${params}`, { signal: searchController.signal });
      if (!response.ok) throw new Error('Location search failed');
      searchResults = (await response.json()).filter((result) => result.address?.country_code === 'ph');

      if (!searchResults.length) {
        status.textContent = 'No matching place found. Try a nearby city or landmark.';
        return;
      }

      status.textContent = 'Choose the closest result, then adjust the pin if needed.';
      results.innerHTML = searchResults.map((result, index) => `
        <button class="search-result" type="button" data-result-index="${index}" role="option">
          <strong>${safe(result.name || result.display_name.split(',')[0])}</strong>
          <small>${safe(result.display_name)}</small>
        </button>`).join('');
      results.querySelectorAll('[data-result-index]').forEach((resultButton) => {
        resultButton.addEventListener('click', () => chooseSearchResult(Number(resultButton.dataset.resultIndex)));
      });
    } catch (searchError) {
      if (searchError.name !== 'AbortError') status.textContent = 'Search is temporarily unavailable. You can still click the map.';
    }
  }

  function chooseSearchResult(index) {
    const result = searchResults[index];
    if (!result || !leafletMap) return;

    const resultLat = Number(result.lat);
    const resultLng = Number(result.lon);
    if (!philippinesBounds.contains([resultLat, resultLng]) || result.address?.country_code !== 'ph') {
      root.querySelector('#search-status').textContent = 'Choose a location within the Philippines.';
      return;
    }

    state.mapLat = resultLat;
    state.mapLng = resultLng;
    state.where = result.display_name;
    state.locationConfirmed = true;
    state.selectedLocationLabel = result.display_name;
    render();
  }

  function saveCurrent() {
    if (state.step === 1) {
      state.name = document.querySelector('#name')?.value.trim() || '';
      state.company = document.querySelector('#company')?.value.trim() || '';
      state.email = document.querySelector('#email')?.value.trim() || '';
      state.phone = formatPhilippinePhone(document.querySelector('#phone')?.value || '');
    }
    if (state.step === 2) {
      state.locationName = document.querySelector('#locationName')?.value.trim() || '';
      state.locationNotes = document.querySelector('#locationNotes')?.value.trim() || '';
      state.website = document.querySelector('#website')?.value.trim() || '';
    }
  }

  function showError(message) {
    error.textContent = message;
    error.classList.remove('hidden');
    error.focus();
  }

  function next() {
    saveCurrent();
    if (state.step === 1 && (!state.name || !state.email || !state.email.includes('@') || formatPhilippinePhone(state.phone).replace(/\D/g, '').length !== 11)) {
      showError('Please enter your name, a valid email, and a phone number in 09xx xxx xxxx format.');
      return;
    }
    state.step += 1;
    render();
  }

  function back() {
    saveCurrent();
    state.step = Math.max(1, state.step - 1);
    render();
  }

  async function submitRequest() {
    saveCurrent();
    if (!state.locationName || !state.locationConfirmed || state.mapLat === null || state.mapLng === null) {
      showError('Enter the site name and choose a search result or place a pin on the map.');
      return;
    }
    if (!philippinesBounds.contains([state.mapLat, state.mapLng])) {
      showError('Choose a monitoring location within the Philippines.');
      return;
    }
    const turnstileSiteKey = (window as any).EXCAVISION_CONFIG?.turnstileSiteKey;
    if (turnstileSiteKey && !state.turnstileToken) {
      showError('Complete the verification before sending.');
      return;
    }
    const requestPayload = {
      requestType: state.requestType,
      name: state.name,
      company: state.company,
      email: state.email,
      phone: state.phone,
      locationName: state.locationName,
      locationLabel: state.where,
      locationNotes: state.locationNotes,
      latitude: state.mapLat,
      longitude: state.mapLng,
      website: state.website,
      formStartedAt: state.formStartedAt,
      turnstileToken: state.turnstileToken,
    };

    const submitButton = root.querySelector('[data-submit]');
    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';

    try {
      const supabaseUrl = (window as any).EXCAVISION_CONFIG?.supabaseUrl?.replace(/\/$/, '');
      if (!supabaseUrl) throw new Error('Request service is not configured.');

      const response = await fetch(`${supabaseUrl}/functions/v1/submit-service-request`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(requestPayload),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'We could not send your request. Please try again.');

      document.querySelector('#wizard').classList.add('hidden');
      document.querySelector('#requestIntro').classList.add('hidden');
      document.querySelector('#success').classList.add('show');
      document.querySelector('#request').classList.add('request-complete');
      document.querySelector('#request').scrollIntoView({ behavior: 'auto', block: 'start' });
    } catch (submitError) {
      showError(submitError instanceof Error ? submitError.message : 'We could not send your request. Please try again.');
      submitButton.disabled = false;
      submitButton.textContent = 'Send request';
    }
  }

  const menuToggle = document.querySelector('#menu-toggle');
  const siteNav = document.querySelector('#site-nav');
  if (menuToggle && siteNav) {
    const closeMenu = () => {
      siteNav.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.textContent = 'Menu';
    };
    menuToggle.addEventListener('click', () => {
      const isOpen = siteNav.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.textContent = isOpen ? 'Close' : 'Menu';
    });
    siteNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const hash = link.getAttribute('href');
        if (!hash) return;
        const target = document.querySelector(hash);
        if (!target) return;
        event.preventDefault();
        if (hash === '#top') window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
        else target.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', hash);
      });
    });

    const sectionLinks = Array.from(siteNav.querySelectorAll<HTMLAnchorElement>('a[data-section]'));
    const hero = document.querySelector<HTMLElement>('.hero');
    const sections = sectionLinks
      .map((link) => document.getElementById(link.dataset.section || ''))
      .filter((section): section is HTMLElement => Boolean(section));
    const clearActiveSection = () => sectionLinks.forEach((link) => link.removeAttribute('aria-current'));
    const updateActiveSection = () => {
      const focusLine = 96;
      const current = [hero, ...sections]
        .filter((section): section is HTMLElement => Boolean(section))
        .find((section) => {
          const bounds = section.getBoundingClientRect();
          return bounds.top <= focusLine && bounds.bottom > focusLine;
        });
      if (!current || current === hero) {
        clearActiveSection();
        return;
      }
      sectionLinks.forEach((link) => {
        if (link.dataset.section === current.id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    const sectionObserver = new IntersectionObserver(updateActiveSection, {
      rootMargin: '-96px 0px -78% 0px',
      threshold: 0,
    });
    if (hero) sectionObserver.observe(hero);
    sections.forEach((section) => sectionObserver.observe(section));

    const backToTop = document.querySelector('#backToTop');
    const pageStart = document.querySelector('#page-start');
    if (backToTop && pageStart) {
      new IntersectionObserver(([entry]) => {
        backToTop.classList.toggle('visible', !entry.isIntersecting);
      }, { threshold: 0 }).observe(pageStart);
    }
  }

  render();
</script>

<style is:global>
  @font-face { font-family: 'IBM Plex Mono'; src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'IBM Plex Mono'; src: url('/fonts/ibm-plex-mono-600.woff2') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }

  :root {
    color-scheme: light;
    --ink: #193138;
    --ink-soft: #476067;
    --muted: #64777c;
    --line: #d5e0df;
    --paper: #f2f6f4;
    --panel: #fbfcfa;
    --marine: #12343b;
    --orange: #d96b2f;
