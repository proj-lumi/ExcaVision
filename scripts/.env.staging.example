# Privileged operator tools only. Never upload this file as Edge Function secrets.
SUPABASE_PROJECT_REF=STAGING_PROJECT_REF
SUPABASE_API_URL=https://STAGING_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_ME_SERVER_SECRET_OR_SERVICE_ROLE_KEY
# Admin bootstrap; hosted seeding also needs --allow-hosted-seed.
ADMIN_ONLY=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Project Administrator
SEED_ADMIN_PASSWORD=REPLACE_ME_UNIQUE_STRONG_PASSWORD
# Optional schema-valid contact number; keep private if it identifies a person.
SEED_ADMIN_PHONE=
SEED_DEMO_PHONE=
# Required only when explicitly opting into staging demo data (ADMIN_ONLY=false).
SEED_DEMO_PASSWORD=REPLACE_ME_DIFFERENT_STRONG_PASSWORD
