ABUSE_HASH_SECRET=REPLACE_ME_RANDOM_SECRET
PUBLIC_LANDING_ORIGINS=https://www.example.com
ALLOW_UNVERIFIED_LOCAL_INTAKE=false
ANOMALY_JOB_KEY=REPLACE_ME_RANDOM_SCHEDULER_SECRET
ANOMALY_SCORE_THRESHOLD=0.70
ANOMALY_MIN_MOVEMENT_DEG=0.5
ANOMALY_MIN_MOVEMENT_RATIO=0.2
VAPID_PUBLIC_KEY=REPLACE_ME_MATCHING_MOBILE_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_ME_VAPID_PRIVATE_KEY
