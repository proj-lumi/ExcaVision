---
// WBS 2.0 — Manage Requests: public installation intake.
import 'leaflet/dist/leaflet.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';

const intakeUrl = import.meta.env.PUBLIC_SUPABASE_INTAKE_URL ?? '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const allowUnverifiedIntake = import.meta.env.PUBLIC_ALLOW_UNVERIFIED_INTAKE === 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Installed tilt monitoring for excavation, retaining walls, and equipment bases." />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f9fb" media="(prefers-color-scheme: light)" />
    <title>ExcaVision · Site movement monitoring</title>
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
  </head>
  <body id="top">
    <span id="page-start" class="scroll-sentinel" aria-hidden="true"></span>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="#top" aria-label="ExcaVision home"><img class="brand-mark" src="/logo.svg" alt="" width="36" height="36" /> <span>ExcaVision</span></a>
        <button id="menu-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav id="site-nav" class="nav" aria-label="Main navigation">
          <a href="#scope" data-section="scope">Monitoring</a>
          <a href="#approach" data-section="approach">How it works</a>
          <a href="#system" data-section="system">Customer app</a>
          <a class="nav-cta" href="#request" data-section="request">Request installation</a>
        </nav>
      </div>
    </header>

    <a id="backToTop" class="back-to-top" href="#top" aria-label="Back to top" title="Back to top">↑</a>

    <main>
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy-block">
            <h1>Tilt monitoring for your site.</h1>
            <p class="hero-copy">Each 2.67 m vertical node has four tilt sensors. We install the monitoring unit, then give you managed account access to view readings and alerts.</p>
            <div class="actions">
              <a class="btn btn-primary" href="#request">Request installation</a>
            </div>
          </div>
          <figure class="hero-visual">
            <img src="/media/excavision-node.webp" alt="ExcaVision tilt-monitoring node" width="1510" height="520" fetchpriority="high" decoding="async" />
          </figure>
        </div>
      </section>

      <section id="scope" class="service-scope" aria-labelledby="scope-title">
        <div class="wrap scope-grid">
          <header>
            <h2 id="scope-title">Monitor tilt. Know what changed.</h2>
          </header>
          <div class="scope-list">
            <article><h3>2.67 m nodes</h3><p>Each node is installed vertically at the area you want to monitor.</p></article>
            <article><h3>Four tilt sensors</h3><p>Four tilt sensors provide readings along each node.</p></article>
            <article><h3>Installed by our team</h3><p>We install the units, connect the nodes, and bring the setup online.</p></article>
            <article><h3>Customer app</h3><p>After setup, we invite you to the customer account for your site.</p></article>
          </div>
        </div>
      </section>

      <section id="approach" class="section process-section">
        <div class="wrap">
          <header class="section-heading">
            <h2>How it works.</h2>
          </header>
          <ol class="process-list">
            <li><h3>Request installation</h3><p>Tell us the site areas and node coverage you need.</p></li>
            <li><h3>Plan coverage</h3><p>We review access and vertical node placement with you.</p></li>
            <li><h3>Commission</h3><p>We connect the monitoring units and bring them online.</p></li>
            <li><h3>View your data</h3><p>We invite you to the managed customer account for the installed site.</p></li>
          </ol>
        </div>
      </section>

      <section id="system" class="section system-section">
        <div class="wrap system-grid">
          <figure class="system-visual">
            <picture>
              <source srcset="/media/pwa-monitoring-showcase-dark.webp" media="(prefers-color-scheme: dark)" />
              <img src="/media/pwa-monitoring-showcase-light.webp" alt="ExcaVision customer app" width="1600" height="900" loading="lazy" decoding="async" />
            </picture>
          </figure>
          <div class="system-copy">
            <h2>Site data at a glance.</h2>
            <p>Use your managed customer account to see current readings, history, unit status, warnings, and alerts for your site.</p>
            <div class="boundary-note"><strong>Decision support only.</strong><p>It does not replace an engineer, inspection, or emergency response.</p></div>
          </div>
        </div>
      </section>

      <section id="request" class="request-area">
        <div class="wrap request-grid">
          <header id="requestIntro" class="request-heading">
            <h2>Request installation.</h2>
            <p>We need a few details to get started.</p>
          </header>
          <div class="request-panel">
            <div id="wizard" data-intake-url={intakeUrl} data-turnstile-site-key={turnstileSiteKey} data-allow-unverified={allowUnverifiedIntake}>
              <div class="progress" aria-live="polite"><strong id="stepLabel">1 of 2</strong><span class="progress-bar"><i id="barFill"></i></span><span id="stepName">Contact</span></div>
              <div id="question" class="question"></div>
            </div>
            <div id="success" class="success" role="status">
              <div class="success-mark" aria-hidden="true">✓</div>
              <h2>Request received.</h2>
              <p>We’ll contact you about the site and next step.</p>
            </div>
          </div>
        </div>
        <dialog id="image-preview-dialog" class="image-preview-dialog" aria-labelledby="image-preview-title">
          <div class="image-preview-shell">
            <header><div><strong id="image-preview-title">Photo preview</strong><span id="image-preview-count"></span></div><button type="button" data-close-preview aria-label="Close photo preview">×</button></header>
            <div class="image-preview-stage">
              <button type="button" data-previous-image aria-label="Previous photo">‹</button>
              <img id="image-preview" src="" alt="" />
              <button type="button" data-next-image aria-label="Next photo">›</button>
            </div>
            <footer><span id="image-preview-name"></span><button type="button" data-remove-preview>Remove photo</button></footer>
          </div>
        </dialog>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div><strong>ExcaVision</strong><span>Tilt sensors and monitoring app</span></div>
      </div>
    </footer>
  </body>
</html>

<script>
  import L from 'leaflet';

  const state = {
    step: 1,
    request_type: 'site_installation',
    requester_name: '',
    company_name: '',
    contact_email: '',
    contact_phone: '',
    site_name: '',
    details: '',
    requested_units: [{ name: '', nodes: 3 }],
    location_confirmed: false,
    address_label: '',
    latitude: null,
    longitude: null,
    attachments: [],
  };

  const steps = ['Contact', 'Site details', 'Monitoring units', 'Location', 'Review'];
  const emailPattern = /^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$/;
  const maxAttachments = 5;
  const maxAttachmentBytes = 5 * 1024 * 1024;
  const allowedImageTypes = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif']);
  const philippinesBounds = L.latLngBounds([4.2, 116.5], [21.5, 127.0]);
  const wizard = document.querySelector('#wizard');
  const intakeUrl = wizard?.dataset.intakeUrl || '';
  const turnstileSiteKey = wizard?.dataset.turnstileSiteKey || '';
  const allowUnverifiedIntake = wizard?.dataset.allowUnverified === 'true';
  const root = document.querySelector('#question');
  const requestPanel = document.querySelector('.request-panel');
  function currentError() {
    return root.querySelector('#form-error');
  }
  function clearError() {
    currentError()?.classList.add('hidden');
    requestPanel?.classList.remove('has-error');
  }
  const imagePreviewDialog = document.querySelector('#image-preview-dialog');
  let leafletMap;
  let mapMarker;
  let searchResults = [];
  let previewImageIndex = 0;
  let turnstileToken = '';
  let turnstileWidgetId;

  function safe(value) {
    return String(value || '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[character]));
  }

  function formatPhilippinePhone(value) {
    let digits = String(value || '').replace(/\D/g, '');
    if (digits.startsWith('63')) digits = `0${digits.slice(2)}`;
    digits = digits.slice(0, 11);
    return [digits.slice(0, 4), digits.slice(4, 7), digits.slice(7, 11)].filter(Boolean).join(' ');
  }

  function updateProgress() {
    document.querySelector('#stepLabel').textContent = `${state.step} of ${steps.length}`;
    document.querySelector('#stepName').textContent = steps[state.step - 1];
    document.querySelector('#barFill').style.transform = `scaleX(${state.step / steps.length})`;
    clearError();
  }

  function animateQuestion() {
    root.classList.remove('question-enter');
    void root.offsetWidth;
    root.classList.add('question-enter');
  }

  function resetMap() {
    if (leafletMap) {
      leafletMap.remove();
      leafletMap = undefined;
      mapMarker = undefined;
    }
  }

  function initMap() {
    const mapElement = document.querySelector('#location-map');
    if (!mapElement) return;

    leafletMap = L.map(mapElement, {
      zoomControl: false,
      maxBounds: philippinesBounds,
      maxBoundsViscosity: 1,
      minZoom: 5,
    }).setView([12.8797, 121.774], 5);
    L.control.zoom({ position: 'bottomright' }).addTo(leafletMap);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a> contributors',
    }).addTo(leafletMap);
    requestAnimationFrame(() => leafletMap?.invalidateSize());

    if (state.location_confirmed && state.latitude !== null && state.longitude !== null) {
      setMarker([state.latitude, state.longitude]);
      leafletMap.setView([state.latitude, state.longitude], 13);
    }

    leafletMap.on('click', (event) => {
      if (!philippinesBounds.contains(event.latlng)) {
        showError('Choose a location within the Philippines.');
        return;
      }
      state.latitude = event.latlng.lat;
      state.longitude = event.latlng.lng;
      state.location_confirmed = true;
      state.address_label = 'Finding address...';
      const searchInput = document.querySelector('#location-search');
      if (searchInput) searchInput.value = '';
      document.querySelector('.map-search-row')?.classList.add('hidden');
      document.querySelector('#selected-place')?.classList.remove('hidden');
      document.querySelector('#selected-place span').textContent = state.address_label;
      document.querySelector('#search-results').innerHTML = '';
      document.querySelector('#search-status').textContent = '';
      setMarker([state.latitude, state.longitude]);
      void reverseGeocode(state.latitude, state.longitude);
    });
  }

  function setMarker(latLng) {
    const markerIcon = L.divIcon({
      className: 'location-marker',
      html: '<span></span>',
      iconSize: [20, 20],
      iconAnchor: [10, 10],
    });

    if (mapMarker) mapMarker.setLatLng(latLng);
    else mapMarker = L.marker(latLng, { icon: markerIcon }).addTo(leafletMap);
  }

  async function reverseGeocode(latitude, longitude) {
    const selectedAddress = root.querySelector('#selected-place span');
    try {
      const params = new URLSearchParams({ format: 'jsonv2', lat: String(latitude), lon: String(longitude), zoom: '18', addressdetails: '1' });
      const response = await fetch(`https://nominatim.openstreetmap.org/reverse?${params}`, { headers: { 'Accept-Language': 'en' } });
      if (!response.ok) throw new Error('Reverse geocoding failed');
      const result = await response.json();
      if (state.latitude !== latitude || state.longitude !== longitude) return;
      const address = result.address || {};
      state.address_label = [address.road, address.neighbourhood || address.suburb, address.city || address.town || address.municipality || address.village, address.state || address.province]
        .filter(Boolean)
        .join(', ') || result.display_name || 'Approximate location';
      if (selectedAddress) selectedAddress.textContent = state.address_label;
    } catch {
      if (state.latitude === latitude && state.longitude === longitude) {
        state.address_label = 'Approximate location';
        if (selectedAddress) selectedAddress.textContent = state.address_label;
      }
    }
  }

  function useCurrentLocation() {
    const status = root.querySelector('#search-status');
    if (!navigator.geolocation) {
      status.textContent = 'Location access is unavailable in this browser.';
      return;
    }
    if (!window.isSecureContext && !['localhost', '127.0.0.1'].includes(window.location.hostname)) {
      status.textContent = 'Location access requires HTTPS.';
      return;
    }
    status.textContent = 'Requesting location permission...';
    navigator.geolocation.getCurrentPosition(({ coords }) => {
      const latitude = coords.latitude;
      const longitude = coords.longitude;
      if (!philippinesBounds.contains([latitude, longitude])) {
        status.textContent = 'Your location is outside the Philippines.';
        return;
      }
      state.latitude = latitude;
      state.longitude = longitude;
      state.location_confirmed = true;
      state.address_label = 'Finding address...';
      root.querySelector('#location-search').value = '';
      root.querySelector('.map-search-row').classList.add('hidden');
      root.querySelector('#selected-place').classList.remove('hidden');
      root.querySelector('#selected-place span').textContent = state.address_label;
      root.querySelector('#search-results').innerHTML = '';
      status.textContent = '';
      setMarker([latitude, longitude]);
      leafletMap.setView([latitude, longitude], 15);
      void reverseGeocode(latitude, longitude);
    }, (locationError) => {
      status.textContent = locationError.code === 1
        ? 'Location permission was not granted. You can search or place the pin manually.'
        : 'Location unavailable. You can search or place the pin manually.';
    }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 300000 });
  }

  function renderRequestedUnits() {
    const list = root.querySelector('#requested-units');
    if (!list) return;
    list.innerHTML = state.requested_units.map((unit, index) => `
      <div class="requested-unit-row">
        <label class="sr-only" for="requested-unit-name-${index}">Unit ${index + 1} name (required)</label>
        <input id="requested-unit-name-${index}" data-requested-unit-name="${index}" value="${safe(unit.name)}" maxlength="120" placeholder="Enter unit name" required />
        <label class="sr-only" for="requested-unit-nodes-${index}">Unit ${index + 1} nodes (required)</label>
        <input id="requested-unit-nodes-${index}" data-requested-unit-nodes="${index}" type="number" min="1" max="16" value="${unit.nodes}" required />
        ${state.requested_units.length > 1 ? `<button class="remove-unit-btn" type="button" data-remove-requested-unit="${index}" aria-label="Remove unit ${index + 1}">×</button>` : '<span class="remove-unit-spacer" aria-hidden="true"></span>'}
      </div>`).join('');
    list.querySelectorAll('[data-requested-unit-name]').forEach((input) => input.addEventListener('input', (event) => {
      state.requested_units[Number(event.target.dataset.requestedUnitName)].name = event.target.value;
    }));
    list.querySelectorAll('[data-requested-unit-nodes]').forEach((input) => input.addEventListener('input', (event) => {
      state.requested_units[Number(event.target.dataset.requestedUnitNodes)].nodes = Number(event.target.value);
    }));
    list.querySelectorAll('[data-remove-requested-unit]').forEach((button) => button.addEventListener('click', () => {
      state.requested_units.splice(Number(button.dataset.removeRequestedUnit), 1);
      renderRequestedUnits();
    }));
  }

  function render(animate = true) {
    state.step = Math.min(5, Math.max(1, Number(state.step) || 1));
    resetMap();
    if (turnstileWidgetId !== undefined && window.turnstile) window.turnstile.remove(turnstileWidgetId);
    turnstileWidgetId = undefined;
    turnstileToken = '';
    updateProgress();
    root.classList.toggle('contact-question', state.step === 1);
    root.classList.toggle('site-details-question', state.step === 2);
    root.classList.toggle('unit-question', state.step === 3);

    if (state.step === 1) {
      root.innerHTML = `
        <h3>Your details</h3>
        <div class="form-grid">
          <div class="field"><label for="name">Full name <span class="required" aria-hidden="true">*</span></label><input id="name" value="${safe(state.requester_name)}" autocomplete="name" placeholder="Enter full name" required /></div>
          <div class="field"><label for="company">Company <span class="hint">(Optional)</span></label><input id="company" value="${safe(state.company_name)}" placeholder="Enter company name" /></div>
          <div class="field"><label for="email">Email <span class="required" aria-hidden="true">*</span></label><input id="email" value="${safe(state.contact_email)}" type="email" autocomplete="email" placeholder="you@example.com" required /></div>
          <div class="field"><label for="phone">Phone <span class="required" aria-hidden="true">*</span></label><input id="phone" value="${safe(formatPhilippinePhone(state.contact_phone))}" autocomplete="tel" inputmode="tel" maxlength="13" placeholder="09xxxxxxxxx" required /></div>
        </div>
        <div id="form-error" class="error hidden" role="alert" tabindex="-1"></div>
        <div class="question-actions"><button class="text-btn" type="button" data-back disabled aria-disabled="true">Back</button><button class="btn btn-primary" type="button" data-next>Continue</button></div>`;
      if (animate) animateQuestion();

      root.querySelector('#phone').addEventListener('input', (event) => {
        event.target.value = formatPhilippinePhone(event.target.value);
      });
      root.querySelector('[data-back]').addEventListener('click', back);
      root.querySelector('[data-next]').addEventListener('click', next);
      return;
    }

    if (state.step === 2) {
      root.innerHTML = `
        <h3>Site details</h3>
        <div class="location-fields site-details-fields">
          <div class="field"><label for="locationName">Site name <span class="required" aria-hidden="true">*</span></label><input id="locationName" value="${safe(state.site_name)}" placeholder="Site or project name" required /></div>
          <div class="field"><label for="locationNotes">Location details <span class="hint">(Optional)</span></label><textarea id="locationNotes" placeholder="Add access or landmark details">${safe(state.details)}</textarea></div>
          <div class="image-field">
            <div class="image-heading"><label>Photos <span class="hint">(Optional)</span></label><span>Up to 5 · 5 MB each</span></div>
            <div class="image-actions">
              <label class="file-action" for="camera-images"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 7h3l1.4-2h5.2L16 7h3a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z"/><circle cx="12" cy="13" r="3.2"/></svg>Camera<input id="camera-images" class="file-input" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" capture="environment" /></label>
              <label class="file-action" for="gallery-images"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="14" height="14" rx="2"/><path d="m5.5 15 3-3 2.2 2.2 1.8-1.8 3.5 3.5M17 8h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-2"/></svg>Gallery<input id="gallery-images" class="file-input" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple /></label>
            </div>
            <div id="image-list" class="image-list" aria-live="polite"></div>
            <div id="form-error" class="error hidden" role="alert" tabindex="-1"></div>
          </div>
        </div>
        <div class="question-actions"><button class="text-btn" type="button" data-back>Back</button><button class="btn btn-primary" type="button" data-next>Continue</button></div>`;
      if (animate) animateQuestion();
      root.querySelector('#locationName').addEventListener('input', (event) => { state.site_name = event.target.value; });
      root.querySelector('#locationNotes').addEventListener('input', (event) => { state.details = event.target.value; });
      root.querySelector('#camera-images').addEventListener('change', (event) => { addImages(event.target.files); event.target.value = ''; });
      root.querySelector('#gallery-images').addEventListener('change', (event) => { addImages(event.target.files); event.target.value = ''; });
      renderImageList();
      root.querySelector('[data-back]').addEventListener('click', back);
      root.querySelector('[data-next]').addEventListener('click', next);
      return;
    }

    if (state.step === 3) {
      root.innerHTML = `
        <h3>Monitoring units</h3>
        <div class="location-fields unit-fields">
          <div class="unit-spec-note"><strong><span class="spec-emphasis">2.67 m</span> per node</strong><span>Each node has <span class="spec-emphasis">four tilt sensors</span>.</span></div>
          <div class="requested-units-field requested-units-page">
            <div class="image-heading"><label>Monitoring units <span class="required" aria-hidden="true">*</span></label><button class="text-btn" type="button" data-add-requested-unit>Add unit</button></div>
            <div class="requested-unit-head" aria-hidden="true"><span>Unit name <span class="required">*</span></span><span>Nodes <span class="required">*</span></span><span></span></div>
            <div id="requested-units" class="requested-unit-list"></div>
          </div>
        </div>
        <div id="form-error" class="error hidden" role="alert" tabindex="-1"></div>
        <div class="question-actions"><button class="text-btn" type="button" data-back>Back</button><button class="btn btn-primary" type="button" data-next>Continue</button></div>`;
      if (animate) animateQuestion();
      renderRequestedUnits();
      root.querySelector('[data-add-requested-unit]').addEventListener('click', () => {
        if (state.requested_units.length >= 20) return;
        state.requested_units.push({ name: '', nodes: 3 });
        renderRequestedUnits();
      });
      root.querySelector('[data-back]').addEventListener('click', back);
      root.querySelector('[data-next]').addEventListener('click', next);
      return;
    }

    if (state.step === 4) {
      root.innerHTML = `
        <h3>Choose the site location</h3>
        <div class="map-card location-only">
          <div class="map-search">
            <label for="location-search">Site location <span class="required" aria-hidden="true">*</span></label>
            <div class="map-search-row ${state.location_confirmed ? 'hidden' : ''}"><input id="location-search" type="search" autocomplete="off" placeholder="Search for the site" /><button id="use-current-location" class="location-gps" type="button">Use my location</button></div>
            <div id="selected-place" class="selected-place ${state.location_confirmed ? '' : 'hidden'}"><span>${safe(state.address_label)}</span><button type="button" data-change-location>Change</button></div>
            <div id="search-status" class="search-status" aria-live="polite"></div>
            <div id="search-results" class="search-results" role="listbox"></div>
          </div>
          <div id="location-map" class="map-box" aria-label="Approximate location picker"></div>
        </div>
        <div id="form-error" class="error hidden" role="alert" tabindex="-1"></div>
        <div class="question-actions"><button class="text-btn" type="button" data-back>Back</button><button class="btn btn-primary" type="button" data-next>Continue</button></div>`;
      if (animate) animateQuestion();
      root.querySelector('[data-change-location]')?.addEventListener('click', () => {
        state.location_confirmed = false;
        state.address_label = '';
        state.latitude = null;
        state.longitude = null;
        render(false);
      });
      root.querySelector('[data-back]').addEventListener('click', back);
      root.querySelector('[data-next]').addEventListener('click', next);
      root.querySelector('#location-search').addEventListener('input', scheduleSearch);
      root.querySelector('#use-current-location').addEventListener('click', useCurrentLocation);
      initMap();
      return;
    }

    root.innerHTML = `
      <h3>Check your details</h3>
      <div class="review-summary">
        <div><span>Name</span><strong>${safe(state.requester_name)}</strong></div>
        <div><span>Company</span><strong>${safe(state.company_name || 'Not provided')}</strong></div>
        <div><span>Email</span><strong>${safe(state.contact_email)}</strong></div>
        <div><span>Phone</span><strong>${safe(formatPhilippinePhone(state.contact_phone))}</strong></div>
        <div><span>Site</span><strong>${safe(state.site_name)}</strong></div>
        <div><span>Photos</span><strong>${state.attachments.length ? `${state.attachments.length} attached` : 'None attached'}</strong></div>
        <div class="review-wide"><span>Units</span><strong>${safe(state.requested_units.map((unit) => `${unit.name || 'Unnamed'} (${unit.nodes})`).join(' · '))}</strong></div>
        <div class="review-wide"><span>Address</span><strong>${safe(state.address_label || 'Location selected')}</strong></div>
      </div>
      <div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
      <div id="turnstile-widget" class="turnstile-widget" aria-label="Human verification"></div>
      <div id="form-error" class="error hidden" role="alert" tabindex="-1"></div>
      <p class="request-note">We’ll contact you after we review your request.</p>
      <div class="question-actions"><button class="text-btn" type="button" data-back>Back</button><button class="btn btn-primary" type="button" data-submit>Send request</button></div>`;
    if (animate) animateQuestion();
    root.querySelector('[data-back]').addEventListener('click', back);
    root.querySelector('[data-submit]').addEventListener('click', submitRequest);
    renderTurnstile();
  }

  function renderTurnstile(attempt = 0) {
    const container = root.querySelector('#turnstile-widget');
    if (!container) return;
    if (allowUnverifiedIntake) { container.remove(); return; }
    if (!intakeUrl || !turnstileSiteKey) {
      container.textContent = 'Request service is not configured.';
      container.classList.add('verification-unavailable');
      return;
    }
    if (!window.turnstile) {
      if (attempt < 40) window.setTimeout(() => renderTurnstile(attempt + 1), 100);
      else showError('Human verification could not be loaded. Check your connection and try again.');
      return;
    }
    turnstileWidgetId = window.turnstile.render(container, {
      sitekey: turnstileSiteKey,
      action: 'site_installation',
      callback: (token) => { turnstileToken = token; },
      'expired-callback': () => { turnstileToken = ''; },
      'error-callback': () => { turnstileToken = ''; },
    });
  }

  let searchTimer;
  let searchController;

  function scheduleSearch() {
    const input = root.querySelector('#location-search');
    const status = root.querySelector('#search-status');
    const results = root.querySelector('#search-results');
    const query = input.value.trim();

    window.clearTimeout(searchTimer);
    if (searchController) searchController.abort();
    results.innerHTML = '';

    if (query.length < 2) {
      status.textContent = query ? 'Type at least 2 characters to see suggestions.' : '';
      return;
    }

    status.textContent = 'Looking for matching places...';
    searchTimer = window.setTimeout(() => searchLocations(query), 350);
  }

  async function searchLocations(query) {
    const status = root.querySelector('#search-status');
    const results = root.querySelector('#search-results');
    searchController = new AbortController();

    try {
      const params = new URLSearchParams({
        q: query,
        format: 'jsonv2',
        addressdetails: '1',
        countrycodes: 'ph',
        limit: '5',
      });
      const response = await fetch(`https://nominatim.openstreetmap.org/search?${params}`, { signal: searchController.signal });
      if (!response.ok) throw new Error('Location search failed');
      searchResults = (await response.json()).filter((result) => result.address?.country_code === 'ph');

      if (!searchResults.length) {
        status.textContent = 'No matching place found. Try a nearby city or landmark.';
        return;
      }

      status.textContent = 'Choose the closest result, then adjust the pin if needed.';
      results.innerHTML = searchResults.map((result, index) => `
        <button class="search-result" type="button" data-result-index="${index}" role="option">
          <strong>${safe(result.name || result.display_name.split(',')[0])}</strong>
          <small>${safe(result.display_name)}</small>
        </button>`).join('');
      results.querySelectorAll('[data-result-index]').forEach((resultButton) => {
        resultButton.addEventListener('click', () => chooseSearchResult(Number(resultButton.dataset.resultIndex)));
      });
    } catch (searchError) {
      if (searchError.name !== 'AbortError') status.textContent = 'Search is temporarily unavailable. You can still click the map.';
    }
  }

  function chooseSearchResult(index) {
    const result = searchResults[index];
    if (!result || !leafletMap) return;

    const resultLat = Number(result.lat);
    const resultLng = Number(result.lon);
    if (!philippinesBounds.contains([resultLat, resultLng]) || result.address?.country_code !== 'ph') {
      root.querySelector('#search-status').textContent = 'Choose a location within the Philippines.';
      return;
    }

    state.latitude = resultLat;
    state.longitude = resultLng;
    state.location_confirmed = true;
    state.address_label = result.display_name;
    render(false);
  }

  async function addImages(fileList) {
    const selected = Array.from(fileList || []);
    if (!selected.length) {
      showError('Choose a photo from your camera or gallery.');
      return;
    }
    if (selected.some((file) => !allowedImageTypes.has(file.type))) {
      showError('Use JPEG, PNG, WebP, HEIC, or HEIF photos only.');
      return;
    }
    if (selected.some((file) => file.size > maxAttachmentBytes)) {
      showError('Each photo must be 5 MB or smaller.');
      return;
    }
    const files = selected.filter((file) => !state.attachments.some((image) => image.file.name === file.name && image.file.size === file.size && image.file.lastModified === file.lastModified));
    if (!files.length) {
      showError('That photo is already attached.');
      return;
    }
    if (state.attachments.length + files.length > maxAttachments) {
      showError('You can add up to 5 photos. Remove one to add another.');
      return;
    }
    let previews;
    try {
      previews = await Promise.all(files.map((file) => readImagePreview(file)));
    } catch {
      showError('This photo could not be shown. Try another.');
      return;
    }
    previews.forEach((url, index) => state.attachments.push({ file: files[index], url }));
    clearError();
    renderImageList();
  }

  function readImagePreview(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.addEventListener('load', () => resolve(String(reader.result)));
      reader.addEventListener('error', () => reject(new Error('Image preview failed')));
      reader.readAsDataURL(file);
    });
  }

  function renderImageList() {
    const list = root.querySelector('#image-list');
    if (!list) return;

    const visibleCount = Math.min(state.attachments.length, 3);
    const thumbnails = state.attachments.slice(0, visibleCount).map((image, index) => `
      <button class="selected-image" type="button" data-preview-image="${index}" aria-label="Preview ${safe(image.file.name)}">
        <img src="${safe(image.url)}" alt="" />
      </button>`);

    if (state.attachments.length > 3) {
      const groupedImage = state.attachments[3];
      thumbnails.push(`
        <button class="selected-image grouped-image" type="button" data-preview-image="3" aria-label="Preview ${state.attachments.length - 3} more photos">
          <img src="${safe(groupedImage.url)}" alt="" />
          <span>+${state.attachments.length - 3}</span>
        </button>`);
    }

    list.innerHTML = thumbnails.join('');
    list.querySelectorAll('[data-preview-image]').forEach((button) => {
      button.addEventListener('click', () => openImagePreview(Number(button.dataset.previewImage)));
    });
  }

  function openImagePreview(index) {
    if (!state.attachments[index] || !imagePreviewDialog) return;
    previewImageIndex = index;
    renderImagePreview();
    imagePreviewDialog.showModal();
  }

  function renderImagePreview() {
    const image = state.attachments[previewImageIndex];
    if (!image || !imagePreviewDialog) return;
    imagePreviewDialog.querySelector('#image-preview').src = image.url;
    imagePreviewDialog.querySelector('#image-preview').alt = image.file.name;
    imagePreviewDialog.querySelector('#image-preview-name').textContent = image.file.name;
    imagePreviewDialog.querySelector('#image-preview-count').textContent = `${previewImageIndex + 1} of ${state.attachments.length}`;
    imagePreviewDialog.querySelector('[data-previous-image]').disabled = state.attachments.length < 2;
    imagePreviewDialog.querySelector('[data-next-image]').disabled = state.attachments.length < 2;
  }

  imagePreviewDialog?.querySelector('[data-close-preview]')?.addEventListener('click', () => imagePreviewDialog.close());
  imagePreviewDialog?.querySelector('[data-previous-image]')?.addEventListener('click', () => {
    previewImageIndex = (previewImageIndex - 1 + state.attachments.length) % state.attachments.length;
    renderImagePreview();
  });
  imagePreviewDialog?.querySelector('[data-next-image]')?.addEventListener('click', () => {
    previewImageIndex = (previewImageIndex + 1) % state.attachments.length;
    renderImagePreview();
  });
  imagePreviewDialog?.querySelector('[data-remove-preview]')?.addEventListener('click', () => {
    state.attachments.splice(previewImageIndex, 1);
    renderImageList();
    if (!state.attachments.length) {
      imagePreviewDialog.close();
      return;
    }
    previewImageIndex = Math.min(previewImageIndex, state.attachments.length - 1);
    renderImagePreview();
  });
  imagePreviewDialog?.addEventListener('click', (event) => {
    if (event.target === imagePreviewDialog) imagePreviewDialog.close();
  });

  function clearImagePreviews() {
    state.attachments = [];
  }

  function saveCurrent() {
    if (state.step === 1) {
      state.requester_name = document.querySelector('#name')?.value.trim() || '';
      state.company_name = document.querySelector('#company')?.value.trim() || '';
      state.contact_email = document.querySelector('#email')?.value.trim() || '';
      state.contact_phone = formatPhilippinePhone(document.querySelector('#phone')?.value || '').replace(/\D/g, '');
    }
    if (state.step === 2) {
      state.site_name = document.querySelector('#locationName')?.value.trim() || '';
      state.details = document.querySelector('#locationNotes')?.value.trim() || '';
    }
  }

  function showError(message) {
    const error = currentError();
    if (!error) return;
    error.textContent = message;
    error.classList.remove('hidden');
    requestPanel?.classList.add('has-error');
    error.focus();
  }

  function next() {
    saveCurrent();
    if (state.step === 1 && (!state.requester_name || !emailPattern.test(state.contact_email) || !/^09\d{9}$/.test(state.contact_phone))) {
      showError('Enter your name, a valid email, and a phone number.');
      return;
    }
    if (state.step === 2 && !state.site_name) {
      showError('Enter the site name to continue.');
      return;
    }
    if (state.step === 3 && !state.requested_units.every((unit) => unit.name.trim() && Number.isInteger(unit.nodes) && unit.nodes >= 1 && unit.nodes <= 16)) {
      showError('Add a name and node count for each monitoring unit.');
      return;
    }
    if (state.step === 4 && (!state.location_confirmed || state.latitude === null || state.longitude === null)) {
      showError('Choose a site location to continue.');
      return;
    }
    if (state.step < 5) {
      state.step += 1;
      render();
    }
  }

  function back() {
    if (state.step <= 1) {
      state.step = 1;
      return;
    }
    saveCurrent();
    state.step -= 1;
    render();
  }

  async function submitRequest() {
    saveCurrent();
    if (!state.site_name || !state.requested_units.every((unit) => unit.name.trim() && Number.isInteger(unit.nodes) && unit.nodes >= 1 && unit.nodes <= 16) || !state.location_confirmed || state.latitude === null || state.longitude === null) {
      showError('Complete the site, unit, and location fields.');
      return;
    }
    if (!philippinesBounds.contains([state.latitude, state.longitude])) {
      showError('Choose a location in the Philippines.');
      return;
    }
    if (!intakeUrl) {
      showError('Request service is temporarily unavailable. Please try again later.');
      return;
    }
    if (!allowUnverifiedIntake && !turnstileToken) {
      showError('Complete the check before sending your request.');
      return;
    }
    if (state.attachments.length > maxAttachments || state.attachments.some(({ file }) => !allowedImageTypes.has(file.type) || file.size > maxAttachmentBytes)) {
      showError('Attachments must be JPEG, PNG, WebP, HEIC, or HEIF photos no larger than 5 MB each.');
      return;
    }

    const submitButton = root.querySelector('[data-submit]');
    submitButton.disabled = true;
    submitButton.classList.add('is-loading');
    submitButton.setAttribute('aria-busy', 'true');
    submitButton.textContent = 'Sending…';
    const formData = new FormData();
    formData.append('request_type', state.request_type);
    formData.append('requester_name', state.requester_name);
    formData.append('company_name', state.company_name);
    formData.append('contact_email', state.contact_email);
    formData.append('contact_phone', state.contact_phone);
    formData.append('site_name', state.site_name);
    formData.append('address_label', state.address_label);
    formData.append('latitude', String(state.latitude));
    formData.append('longitude', String(state.longitude));
    formData.append('details', state.details);
    formData.append('requested_units', JSON.stringify(state.requested_units));
    formData.append('website', root.querySelector('#website')?.value || '');
    formData.append('cf-turnstile-response', turnstileToken);
    state.attachments.forEach(({ file }) => formData.append('attachments', file));

    try {
      const response = await fetch(intakeUrl, {
        method: 'POST',
        headers: { 'x-turnstile-token': turnstileToken },
        body: formData,
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Request could not be sent.');
      clearImagePreviews();
      document.querySelector('#wizard').classList.add('hidden');
      document.querySelector('#success').classList.add('show');
      document.querySelector('#request').classList.add('request-complete');
    } catch (submissionError) {
      showError(submissionError instanceof Error ? submissionError.message : 'Request could not be sent.');
      turnstileToken = '';
      if (turnstileWidgetId !== undefined && window.turnstile) window.turnstile.reset(turnstileWidgetId);
      submitButton.disabled = false;
      submitButton.classList.remove('is-loading');
      submitButton.removeAttribute('aria-busy');
      submitButton.textContent = 'Send request';
    }
  }

  const menuToggle = document.querySelector('#menu-toggle');
  const siteNav = document.querySelector('#site-nav');
  if (menuToggle && siteNav) {
    const closeMenu = () => {
      siteNav.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.textContent = 'Menu';
    };
    menuToggle.addEventListener('click', () => {
      const isOpen = siteNav.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.textContent = isOpen ? 'Close' : 'Menu';
    });
    siteNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const hash = link.getAttribute('href');
        if (!hash) return;
        const target = document.querySelector(hash);
        if (!target) return;
        event.preventDefault();
        if (hash === '#top') window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
        else target.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', hash);
      });
    });

    const sectionLinks = Array.from(siteNav.querySelectorAll<HTMLAnchorElement>('a[data-section]'));
    const hero = document.querySelector<HTMLElement>('.hero');
    const sections = sectionLinks
      .map((link) => document.getElementById(link.dataset.section || ''))
      .filter((section): section is HTMLElement => Boolean(section));
    const clearActiveSection = () => sectionLinks.forEach((link) => link.removeAttribute('aria-current'));
    const updateActiveSection = () => {
      const focusLine = 96;
      const current = [hero, ...sections]
        .filter((section): section is HTMLElement => Boolean(section))
        .find((section) => {
          const bounds = section.getBoundingClientRect();
          return bounds.top <= focusLine && bounds.bottom > focusLine;
        });
      if (!current || current === hero) {
        clearActiveSection();
        return;
      }
      sectionLinks.forEach((link) => {
        if (link.dataset.section === current.id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    const sectionObserver = new IntersectionObserver(updateActiveSection, {
      rootMargin: '-96px 0px -78% 0px',
      threshold: 0,
    });
    if (hero) sectionObserver.observe(hero);
    sections.forEach((section) => sectionObserver.observe(section));

    const backToTop = document.querySelector('#backToTop');
    const pageStart = document.querySelector('#page-start');
    if (backToTop && pageStart) {
      new IntersectionObserver(([entry]) => {
        backToTop.classList.toggle('visible', !entry.isIntersecting);
      }, { threshold: 0 }).observe(pageStart);
    }
  }

  render();
</script>

